{
  "name": "21x",
  "productName": "21x",
  "version": "0.0.161",
  "packageManager": "pnpm@9.15.2",
  "description": "21x — AI-powered desktop task manager",
  "main": "./out/main/index.js",
  "author": "Jake Cattrall",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.mobile.config.ts",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/rebuild-native.mjs",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:nav-rail": "node scripts/nav-rail-layout/run.mjs",
    "test:commander-input": "node scripts/commander-input/run.mjs",
    "test:run": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:main": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs --project main",
    "test:renderer": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs --project renderer",
    "lint": "eslint .",
    "typecheck": "tsc --build --noEmit",
    "build:mac": "electron-vite build && vite build --config vite.mobile.config.ts && electron-builder --mac",
    "build:win": "electron-vite build && vite build --config vite.mobile.config.ts && electron-builder --win",
    "build:linux": "electron-vite build && vite build --config vite.mobile.config.ts && electron-builder --linux",
    "prepare": "husky",
    "dev:mobile": "vite --config vite.mobile.config.ts --host",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@activepieces/piece-todoist": "0.5.0",
    "@activepieces/piece-trello": "0.6.0",
    "@agentclientprotocol/codex-acp": "^1.9.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.260",
    "@anthropic-ai/sdk": "^0.123.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.28",
    "@paralleldrive/cuid2": "^2.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cloudflared": "^0.7.1",
    "cron-parser": "^5.5.0",
    "electron-updater": "^6.8.3",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "tar-stream": "^3.2.0",
    "unbzip2-stream": "^1.4.3",
    "undici": "^7.21.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@activepieces/pieces-framework": "0.32.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^2.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.13.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^10.0.1",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "lucide-react": "^0.468.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "overrides": {}
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-warn-ignored"
  },
  "build": {
    "appId": "com.krazyjakee.21x",
    "productName": "21x",
    "protocols": [
      {
        "name": "21x",
        "schemes": [
          "twentyonex",
          "nuanu"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "krazyjakee",
      "repo": "21x"
    },
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node",
      "node_modules/cloudflared/**",
      "out/main/mcp-servers/**",
      "out/main/voice/**",
      "out/main/chunks/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "afterPack": "./scripts/after-pack.js",
    "afterSign": "./scripts/notarize.js",
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "21x uses the microphone for voice dictation and voice task commands. Speech is recognised on this computer and no audio is stored."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "21x",
      "uninstallDisplayName": "21x",
      "include": "resources/installer.nsh"
    },
    "nativeRebuilder": "sequential",
    "npmRebuild": false
  }
}
