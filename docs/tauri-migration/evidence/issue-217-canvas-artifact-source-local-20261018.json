  "proofs": [
    {
      "expected": "Exact dormant canvas/drawing JSON and recording bytes survive shutdown/reopen and rollback without browser effects",
      "actual": "Real SQLite profiles, fragmented private peer, actual Root and staged Root, stopped-profile rehearsal and encrypted backup ownership; working HTTP canary receives zero saved-URL requests; exact JSON/hash/inode comparisons pass"
    },
    {
      "expected": "Removed browser commands/routes/MCP tools are absent or rejected while retained positives work",
      "actual": "Six removed private commands refused by actual engine; authenticated loopback JSON routes explicitly return Unknown route; official MCP client sees no advertised/executable browser tools; task list/settings positives pass"
    },
    {
      "expected": "Failed native loads, reconnects and retired documents cannot overwrite canonical data",
      "actual": "Eleven actual typed-facade old-source controls fail; repaired stores require successful current scoped read, withdraw pending saves, retry read-only on reconnect, drop held old replies and retire on pagehide; Electron fixtures retained"
    },
    {
      "expected": "Optional viewer owner grants no production viewer authority",
      "actual": "No native bridge refuses before read/allocation. Actual Root artifact backend supplies bounded immutable HTML snapshot to synthetic private receipts only. Early open refused; ACK/scope/one-shot/held FD/register/open/failed retire/callback-cycle tests pass. Production bootstrap and public operation manifest unchanged; native viewer unavailable"
    }
  ],
  "failuresAndRepairs": [
    "Initial unused import failed forced typecheck; removed until the later Root viewer fixture required it.",
    "Two initial rollback byte-hash assertions incorrectly included intentional WAL-to-DELETE normalization of the rehearsal working copy. Moved that copy byte invariant after explicit normalization; retained separate untouched stopped-production database hash, exact JSON/resource/backup assertions and actual rollback Root reopen.",
    "Eleven genuine old-store behavior failures reproduced lost-data writes/reconnect/pagehide effects before repair; raw reports archived.",
    "Viewer fixture inferred optional undefined in JsonValue union and used invalid peer role engine. Corrected explicit JsonValue return and existing service role; forced typecheck passed without weakening assertions.",
    "Provider error interrupted previous turn. Wanted WIP remained intact and lead saved backup; resumed focused stage/type/59-case gate passed before local commit/rebase.",
    "Normal commit hooks rejected two prefer-const errors in the new SDK and fixture. Corrected declarations, reran normal hooks and full combined gate; no hooks bypassed.",
    "Overlapping generated-file claims were noticed before mutation. B released, E2 explicitly released, B reclaimed; generated operations remained byte-identical."
  ],
  "criteria": {
    "1": "remaining source/integration gap: installed retained task/terminal/layering/preview/drop matrix; owned native persistence recovery repaired and controlled renderer tests pass",
    "2": "remaining source gap: production native viewer counterpart, sealed bootstrap and UI consumption. Optional Source SDK is implemented and tested but deliberately unregistered/unavailable",
    "3": "blocked: current production separately excluded WebView/native hostile command/plugin/event/navigation and destruction proof requires E2 native viewer; historical diagnostics retain original scope only",
    "4": "source-complete on Linux: actual Source/staged private commands, authenticated HTTP/MCP and actual typed native inert renderer controls; installed supported-target acceptance remains unclaimed",
    "5": "source-complete on Linux: exact synthetic production profile and rollback/recording preservation plus native recovery fences; installed supported-target acceptance remains unclaimed"
  },
