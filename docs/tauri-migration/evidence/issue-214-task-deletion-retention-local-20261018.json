      "fixedActual": "Pass in Source binding and both Source/compiledRoot private-peer variants"
    },
    {
      "scenario": "Accepted normal subtree deletion",
      "expected": "Parent and child rows absent, exact two task:deleted payloads once, protected copies and publication facts retained",
      "actual": "Pass; event order intentionally follows captured DB rows rather than an invented parent-first contract"
    },
    {
      "scenario": "Actual source-owner logical task cascade",
      "expected": "Source/task rows absent; protected copy and published journal fact retained",
      "actual": "Pass through real taskSource:delete owner"
    },
    {
      "scenario": "Private policy capture/invalid values/default host",
      "expected": "Captured retain survives option mutation/direct cleanup; malformed policies refuse construction; omitted default retains legacy cleanup",
      "actual": "Three actual-schema/filesystem controls pass"
    }
