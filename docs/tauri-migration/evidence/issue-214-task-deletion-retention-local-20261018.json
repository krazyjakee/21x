  "implemented": [
    "ProductionOwner always passes private attachmentDeletion:retain when constructing its sole real DatabaseManager.",
    "DatabaseManager captures the policy as a primitive and rejects malformed values; later option mutation cannot restore recursive cleanup.",
    "Protected direct deleteTaskAttachments and every deleteTask caller return from byte cleanup before constructing/traversing a path. Existing logical row, task/subtree/source scopes, exclusion, Stop, transcript cleanup and canonical events remain with their original owners.",
    "Accepted logical deletion retains protected directories and existing private journal facts. No recursive cleanup authority is synthesized from task ID, current-root check or persisted journal entry.",
    "Legacy Electron host construction omits the new private option and retains its existing default behavior; no public API, DTO, retained row/grant or file import semantics change."
  ],
  "expectedActual": [
    {
      "scenario": "Actual retained db:deleteTask after root rename plus symlink to outside synthetic task directory",
      "expected": "Logical true/row absent; outside canary and original protected copy unchanged",
