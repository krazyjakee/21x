  "title": "Native task completion canonical receipts and original Source choice ownership",
  "scope": {
    "renderer": "Actual typed native facade/transport, real task and Source stores/hooks/dialog, controlled native operation/canonical database responses. No Electron preload in new harness.",
    "source": "Separate affected tests exercise actual SQLite/production owners/private peers/compiled Root, controlled adapter and Source children, protected deletion and2 actual staged stdio entries. These do not join native installed WebView delivery with a live remote Source action.",
    "hardware": "Linux x64; no installed supported-platform/native input or live provider proof."
  },
  "expectedActual": [
    {
      "expected": "Completion requires an accepted canonical completed task.",
      "actual": "Manual write checks exact accepted row; linked Source path requires accepted marker, finite action success and strict completed readback. Callback receives canonical row/title, never a synthesized old task."
    },
    {
      "expected": "One original Source choice and view own each completion.",
      "actual": "Synchronous admission prevents duplicates. Original task/project/agent/Source/external/action snapshot stays captured; observed binding replacement cannot retarget. Project withdrawal+return, pagehide, unmount, view replacement and reconnect fence later effects/callbacks. Admitted raw Source work remains owned; no cancellation/rollback promise."
    },
    {
      "expected": "Unknown results remain understandable without replay.",
      "actual": "Fixed review dialog excludes private error text; Close does not readmit the same view. Accepted marker is not reverted. Native ordinary completion refuses Captain/group anchors; exact-root Fresh remains unavailable."
    },
    {
      "expected": "Native board transition keeps one lifecycle owner.",
      "actual": "Completion delegates to the same captured owner; other nonexecution status transitions require canonical destination row. No extra renderer recovery read/Stop before Source locked mutation. Electron orchestration unchanged; full board view/drag lifetime not claimed."
    }
  ],
