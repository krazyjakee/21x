{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.tauri.config.ts",
    "vite.tauri-production.config.ts",
    "vitest.tauri.config.ts",
    "src/main/**/*",
    "src/service/**/*.ts",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/types/index.ts",
    "test/**/*",
    "scripts/production-workspace-cleanup-proof.ts",
    "scripts/production-workspace-cleanup-proof.test.ts",
    "scripts/production-workspace-cleanup-git-fixture.ts",
    "scripts/production-workspace-cleanup-git-fixture.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "out"
  ]
}
